# Private configuration belongs in .env.local or your deployment secret settings.
# Never commit actual credentials.
EXPLORIUM_DB_PATH=./data/explorium.sqlite
# Set the public HTTPS origin when deploying.
EXPLORIUM_APP_URL=
# Optional until an email provider has been configured and verified.
RESEND_API_KEY=
EXPLORIUM_EMAIL_FROM=
EXPLORIUM_REQUIRE_VERIFIED_EMAIL=false
# Provision staff privately; remove the password variable after provisioning.
EXPLORIUM_ACCOUNT_PASSWORD=
EXPLORIUM_ACCOUNT_ROLE=admin
# Enable only when using the environment's configured network proxy.
# NODE_USE_ENV_PROXY=1
