{
  "name": "explorium-nova",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "create:admin": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "test:backend": "node --import tsx --test tests/backend.test.mts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "@fontsource/manrope": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.56.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=24"
  }
}
